# Copy this file to ".env" and fill in real values.
# Never commit your actual .env file — it is already listed in .gitignore.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=utkalayatri

# --- Gemini API (used starting Week 2+) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenRouteService (used later for routing) ---
OPENROUTESERVICE_API_KEY=your_ors_api_key_here

# --- App environment ---
# development | production
APP_ENV=development
